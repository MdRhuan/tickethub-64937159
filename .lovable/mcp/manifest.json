{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "tickethub-bh-mcp",
      "version": "0.1.0",
      "title": "TicketHub BH"
    },
    "tools": [
      {
        "name": "list_events",
        "title": "List events",
        "description": "List upcoming/available events (ingressos) from TicketHub BH. Optionally filter by music genre/category or a text query matching title or venue.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Genre/category filter (e.g. FUNK, SERTANEJO, PAGODE, ROCK, POP).",
              "type": "string"
            },
            "query": {
              "description": "Case-insensitive substring to match against event title or venue.",
              "type": "string"
            },
            "limit": {
              "description": "Max number of results (default 50).",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_event",
        "title": "Get event details",
        "description": "Fetch full details for a single event by its ID, including attractions, ticket links, venue, and dates.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Event ID."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
